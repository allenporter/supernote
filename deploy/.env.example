# Copy to .env and fill in before `docker compose up`.

# The [REDACTED-HOST] box's Tailscale IPv4, from `tailscale ip -4` on that box.
# Used by docker-compose.yml both to bind published ports to the tailnet only
# and to build the base URLs below.
TAILSCALE_IP=100.x.y.z

SUPERNOTE_HOST=0.0.0.0
SUPERNOTE_PORT=8080
SUPERNOTE_STORAGE_DIR=/data

# HTTPS Tailscale Serve URLs, NOT plain http://<tailscale-ip>. The server's
# MCP OAuth code requires an HTTPS issuer and fails startup otherwise
# ("ValueError: Issuer URL must be HTTPS"). Set these up first with:
#   tailscale serve --bg --https=8443 http://127.0.0.1:8080
#   tailscale serve --bg --https=8444 http://127.0.0.1:8081
# then fill in this box's MagicDNS name (`tailscale status` / `tailscale serve status`):
SUPERNOTE_BASE_URL=https://<node>.<tailnet>.ts.net:8443
SUPERNOTE_MCP_BASE_URL=https://<node>.<tailnet>.ts.net:8444

# REQUIRED for a persistent deployment: without this, the server generates a
# random in-memory JWT secret on every restart, silently invalidating the
# Nomad's sync login and any MCP OAuth sessions each time the container
# restarts. Generate once with `openssl rand -hex 32` and never change it.
SUPERNOTE_JWT_SECRET=

# The Mac's Tailscale IP + port 8090, where visionocr-service (issue #1)
# listens. Required for OCR transcription (get_notebook_transcript) — see
# README "OCR and semantic search architecture".
APPLE_VISION_OCR_URL=http://100.x.y.z:8090

# Leave unset for lite mode; not needed for OCR/embeddings/search, which now
# run locally (Apple Vision OCR + the ollama compose service above). Set
# this later only if/when AI summaries get turned on separately.
# SUPERNOTE_GEMINI_API_KEY=
