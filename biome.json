{
  "files": {
    "includes": [
      "supernote/server/static/js/**/*.js",
      "tests/frontend/**/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noAlert": "error"
      }
    }
  }
}
