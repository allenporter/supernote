<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.supernote.visionocr-service</string>

    <key>ProgramArguments</key>
    <array>
        <string>__SERVICE_DIR__/.venv/bin/python</string>
        <string>__SERVICE_DIR__/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SERVICE_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>VISIONOCR_BINARY</key>
        <string>__SERVICE_DIR__/bin/macos-vision-ocr</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__SERVICE_DIR__/logs/visionocr-service.log</string>
    <key>StandardErrorPath</key>
    <string>__SERVICE_DIR__/logs/visionocr-service.err.log</string>
</dict>
</plist>
