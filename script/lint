#!/usr/bin/env bash
# script/lint: Run linters

set -e

cd "$(dirname "$0")/.."

echo "==> Running linters..."

if command -v uv >/dev/null 2>&1; then
  if [ ! -x ".venv/bin/pre-commit" ]; then
    ./script/bootstrap
  fi
  uv run --no-sync pre-commit run --all-files
else
  pre-commit run --all-files
fi
