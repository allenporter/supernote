#!/usr/bin/env bash
# script/test: Run tests

set -e

cd "$(dirname "$0")/.."

echo "==> Running tests..."

PYTEST_ARGS=("$@")
if [ ${#PYTEST_ARGS[@]} -eq 0 ]; then
  PYTEST_ARGS=("-n" "auto" "--dist" "worksteal")
fi

if command -v uv >/dev/null 2>&1; then
  if [ ! -x ".venv/bin/pytest" ]; then
    ./script/bootstrap
  fi
  uv run --no-sync pytest "${PYTEST_ARGS[@]}"
else
  pytest "${PYTEST_ARGS[@]}"
fi
