#!/usr/bin/env bash
# script/server-seed: Seed local development server with sample notes and tasks

set -e

cd "$(dirname "$0")/.."

echo "==> Seeding development server..."

if command -v uv >/dev/null 2>&1; then
  if [ ! -d ".venv" ]; then
    ./script/bootstrap
  fi
  uv run --no-sync supernote cloud seed "$@"
else
  supernote cloud seed "$@"
fi
