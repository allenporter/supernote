{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  assignees: [
    'allenporter',
  ],
  labels: [
    'dependencies',
  ],
  packageRules: [
    {
      description: 'Silent automerge for minor, patch, pin, and digest updates',
      automerge: true,
      automergeType: 'branch',
      assignees: [],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
    },
    {
      description: 'Silent automerge major updates for dev-time tools (Actions, pre-commit, requirements_dev.txt)',
      matchUpdateTypes: ['major'],
      matchManagers: ['github-actions', 'pre-commit', 'pip_requirements'],
      automerge: true,
      automergeType: 'branch',
      assignees: [],
    },
    {
      description: 'Manage .python-version via cookiecutter/cruft template instead of Renovate',
      matchManagers: ['pyenv'],
      enabled: false,
    },
    {
      description: 'Keep Tailwind Play CDN on v3 (cdn.tailwindcss.com only serves v3)',
      matchPackageNames: ['tailwindcss'],
      allowedVersions: '<4.0.0',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Track unpkg ESM/script CDN versions in static HTML',
      fileMatch: [
        '^supernote/server/static/.*\\.html$',
      ],
      matchStrings: [
        'https://unpkg\\.com/(?<depName>@?[^@/]+(?:/[^@/]+)?)@(?<currentValue>[^/"\'\\s]+)/',
      ],
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      description: 'Track Socket.IO CDN versions in static HTML',
      fileMatch: [
        '^supernote/server/static/.*\\.html$',
      ],
      matchStrings: [
        'https://cdn\\.socket\\.io/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/socket\\.io\\.min\\.js',
      ],
      depNameTemplate: 'socket.io-client',
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      description: 'Track Tailwind Play CDN versions in static HTML',
      fileMatch: [
        '^supernote/server/static/.*\\.html$',
      ],
      matchStrings: [
        'https://cdn\\.tailwindcss\\.com/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)',
      ],
      depNameTemplate: 'tailwindcss',
      datasourceTemplate: 'npm',
    },
  ],
  pip_requirements: {
    fileMatch: [
      '^requirements_dev\\.txt$',
    ],
  },
  'pre-commit': {
    enabled: true,
  },
}
