  INSERT INTO "f_user_file" VALUES(741735919479947816,1,741735919471559198,'Note','Y',0,NULL,NULL,'Y',1786302823991,1786302823991);
  INSERT INTO "f_user_file" VALUES(741735919488336254,1,741735919471559198,'MyStyle','Y',0,NULL,NULL,'Y',1786302823993,1786302823993);
  INSERT INTO "f_user_file" VALUES(741735919496724995,1,0,'DOCUMENT','Y',0,NULL,NULL,'Y',1786302823994,1786302823994);
